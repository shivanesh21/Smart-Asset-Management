          <mxGeometry x="300" y="200" width="130" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s_assigned" value="assigned" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;" vertex="1" parent="1">
