{
  "info": {
    "name": "Smart Asset Management - authentication",
    "_postman_id": "c2d3e4f5-2b3c-4d5e-af01-1b2c3d4e5f60",
    "description": "Authentication for asset-service (Day 6).\n\nRun in order. `Register (admin user)` runs first and the collection variable `adminToken` is captured automatically, so the admin-only requests work without manual setup.\n\nSeeded logins from `npm run seed`: admin@example.com / Admin@12345, staff@example.com / Staff@12345, technician@example.com / Tech@12345",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3001" },
    { "key": "accessToken", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "staffToken", "value": "" },
    { "key": "technicianToken", "value": "" }
  ],
  "item": [
    {
      "name": "Register (admin user)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"System Administrator\",\n  \"email\": \"admin@example.com\",\n  \"password\": \"Admin@12345\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created (409 is fine if already registered)', function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([201, 409]);",
              "});",
              "pm.test('self-registration can never yield admin', function () {",
              "    if (pm.response.code === 201) {",
              "        pm.expect(pm.response.json().data.role).to.eql('staff');",
              "    }",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Login admin",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"Admin@12345\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 with a token', function () {",
              "    pm.response.to.have.status(200);",
              "    const b = pm.response.json();",
              "    pm.expect(b.accessToken).to.be.a('string');",
              "    pm.expect(b.tokenType).to.eql('Bearer');",
              "    pm.expect(b.expiresIn).to.be.above(0);",
              "    pm.expect(b.user.passwordHash).to.be.undefined;",
              "});",
              "pm.collectionVariables.set('accessToken', pm.response.json().accessToken);",
              "pm.collectionVariables.set('adminToken', pm.response.json().accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "Login staff",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"staff@example.com\",\n  \"password\": \"Staff@12345\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', function () { pm.response.to.have.status(200); });",
              "pm.collectionVariables.set('staffToken', pm.response.json().accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "Login technician",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"technician@example.com\",\n  \"password\": \"Tech@12345\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', function () { pm.response.to.have.status(200); });",
              "pm.collectionVariables.set('technicianToken', pm.response.json().accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "Login (wrong password -> 401)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"staff@example.com\",\n  \"password\": \"WrongPassword1!\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('401 INVALID_CREDENTIALS', function () {",
              "    pm.response.to.have.status(401);",
              "    pm.expect(pm.response.json().error.code).to.eql('INVALID_CREDENTIALS');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Me",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "auth", "me"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 returns the caller', function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.json().data.email).to.eql('admin@example.com');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "No token -> 401",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/assets", "host": ["{{baseUrl}}"], "path": ["api", "assets"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('401 UNAUTHORIZED', function () {",
              "    pm.response.to.have.status(401);",
              "    pm.expect(pm.response.json().error.code).to.eql('UNAUTHORIZED');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "List users (admin only)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
        "url": { "raw": "{{baseUrl}}/api/users", "host": ["{{baseUrl}}"], "path": ["api", "users"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 for admin', function () { pm.response.to.have.status(200); });",
              "pm.expect(pm.response.json().meta.total).to.be.above(0);"
            ]
          }
        }
      ]
    },
    {
      "name": "List users (staff -> 403)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{staffToken}}" }],
        "url": { "raw": "{{baseUrl}}/api/users", "host": ["{{baseUrl}}"], "path": ["api", "users"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('403 FORBIDDEN for staff', function () {",
              "    pm.response.to.have.status(403);",
              "    pm.expect(pm.response.json().error.code).to.eql('FORBIDDEN');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Create user (admin)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{adminToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Priya Nair\",\n  \"email\": \"priya.nair@example.com\",\n  \"password\": \"Priya@12345\",\n  \"role\": \"technician\",\n  \"department\": \"Facilities\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/users", "host": ["{{baseUrl}}"], "path": ["api", "users"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 and mustChangePassword is true', function () {",
              "    pm.response.to.have.status(201);",
              "    pm.expect(pm.response.json().data.role).to.eql('technician');",
              "    pm.expect(pm.response.json().data.mustChangePassword).to.be.true;",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Create asset (staff allowed)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{staffToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"HP LaserJet Pro M404\",\n  \"category\": \"printer\",\n  \"department\": \"Facilities\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/assets", "host": ["{{baseUrl}}"], "path": ["api", "assets"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created for staff', function () {",
              "    pm.response.to.have.status(201);",
              "    pm.expect(pm.response.json().data.assetId).to.match(/^AST-\\d{4,}$/);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Create asset (technician -> 403)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{technicianToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Should Fail\",\n  \"category\": \"laptop\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/assets", "host": ["{{baseUrl}}"], "path": ["api", "assets"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('403 FORBIDDEN for technician', function () {",
              "    pm.response.to.have.status(403);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "List assets (technician can read)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{technicianToken}}" }],
        "url": { "raw": "{{baseUrl}}/api/assets", "host": ["{{baseUrl}}"], "path": ["api", "assets"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 for technician read', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    }
  ]
}