{
  "info": {
    "name": "Smart Asset Management - asset-service",
    "_postman_id": "b7c1f0e2-1a2b-4c3d-9e8f-0a1b2c3d4e5f",
    "description": "asset-service API (Days 4-5: create, read, update, delete, status, filters).\n\nRun the requests top to bottom: each one saves the variables the next one needs.\nNo environment required, collection variables are used.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "assetId",
      "value": ""
    },
    {
      "key": "assetMongoId",
      "value": ""
    },
    {
      "key": "serialNumber",
      "value": "SN-DEMO-0001"
    }
  ],
  "item": [
    {
      "name": "Login (get token)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"Admin@12345\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 and token captured', function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.json().accessToken).to.be.a('string');",
              "});",
              "pm.collectionVariables.set('accessToken', pm.response.json().accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('health returns 200 ok', function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.json().status).to.eql('ok');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Create Asset",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Dell Latitude 5440\",\n  \"category\": \"laptop\",\n  \"department\": \"Engineering\",\n  \"serialNumber\": \"{{serialNumber}}\",\n  \"condition\": \"new\",\n  \"purchaseDate\": \"2026-01-15\",\n  \"purchaseCost\": 78000,\n  \"currency\": \"INR\",\n  \"manufacturer\": \"Dell\",\n  \"model\": \"Latitude 5440\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/assets",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "assets"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', function () { pm.response.to.have.status(201); });",
              "const body = pm.response.json();",
              "pm.test('assetId is auto-generated as AST-####', function () {",
              "    pm.expect(body.data.assetId).to.match(/^AST-\\d{4,}$/);",
              "});",
              "pm.test('status defaults to draft', function () {",
              "    pm.expect(body.data.status).to.eql('draft');",
              "});",
              "pm.collectionVariables.set('assetId', body.data.assetId);",
              "pm.collectionVariables.set('assetMongoId', body.data.id);",
              "console.log('created', body.data.assetId);"
            ]
          }
        }
      ]
    },
    {
      "name": "Create Asset (duplicate serial -> 409)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Cloned Laptop\",\n  \"category\": \"laptop\",\n  \"serialNumber\": \"{{serialNumber}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/assets",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "assets"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('409 Conflict on duplicate serialNumber', function () {",
              "    pm.response.to.have.status(409);",
              "    pm.expect(pm.response.json().error.code).to.eql('SERIAL_NUMBER_EXISTS');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Create Asset (invalid body -> 400)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"category\": \"spaceship\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/assets",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "assets"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('400 VALIDATION_ERROR with field details', function () {",
              "    pm.response.to.have.status(400);",
              "    const e = pm.response.json().error;",
              "    pm.expect(e.code).to.eql('VALIDATION_ERROR');",
              "    pm.expect(e.details.some(d => d.field === 'name')).to.be.true;",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "List Assets (filters + pagination)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/assets?category=laptop&department=Engineering&page=1&limit=10&sort=-createdAt",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "assets"
          ],
          "query": [
            {
              "key": "category",
              "value": "laptop"
            },
            {
              "key": "department",
              "value": "Engineering"
            },
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "10"
            },
            {
              "key": "sort",
              "value": "-createdAt"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 with pagination envelope', function () {",
              "    pm.response.to.have.status(200);",
              "    const b = pm.response.json();",
              "    pm.expect(Array.isArray(b.data)).to.be.true;",
              "    pm.expect(b.meta).to.have.property('totalPages');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Search Assets",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/assets?search=Latitude",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "assets"
          ],
          "query": [
            {
              "key": "search",
              "value": "Latitude"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 and search matches', function () {",
              "    pm.response.to.have.status(200);",
              "    const b = pm.response.json();",
              "    pm.expect(b.data.length).to.be.above(0);",
              "});"
            ]
          }
        }
      ]
    },
