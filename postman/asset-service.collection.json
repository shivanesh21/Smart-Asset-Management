            "status"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('409 INVALID_TRANSITION listing allowed states', function () {",
              "    pm.response.to.have.status(409);",
              "    const e = pm.response.json().error;",
              "    pm.expect(e.code).to.eql('INVALID_TRANSITION');",
              "    pm.expect(e.details[0].message).to.include('disposed');",
              "});"
            ]
          }
        }
      ]
