        "url": {
          "raw": "{{baseUrl}}/api/assets/{{assetId}}/status",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "assets",
            "{{assetId}}",
            "status"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 and status is in_stock', function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.json().data.status).to.eql('in_stock');",
              "});"
            ]
