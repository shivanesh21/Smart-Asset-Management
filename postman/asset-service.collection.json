        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"disposed\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/assets/{{assetId}}/status",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "assets",
