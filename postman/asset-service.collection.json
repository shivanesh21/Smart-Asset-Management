    {
      "name": "Update Asset (PATCH)",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"department\": \"Finance\",\n  \"notes\": \"Reassigned to Finance\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/assets/{{assetId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "assets",
            "{{assetId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 and only supplied fields changed', function () {",
              "    pm.response.to.have.status(200);",
              "    const d = pm.response.json().data;",
              "    pm.expect(d.department).to.eql('Finance');",
              "    pm.expect(d.name).to.eql('Dell Latitude 5440');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Replace Asset (PUT)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Dell Latitude 5440 (replaced)\",\n  \"category\": \"desktop\",\n  \"serialNumber\": \"{{serialNumber}}\",\n  \"department\": \"Engineering\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/assets/{{assetId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "assets",
            "{{assetId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 and assetId is unchanged', function () {",
              "    pm.response.to.have.status(200);",
              "    const d = pm.response.json().data;",
              "    pm.expect(d.category).to.eql('desktop');",
              "    pm.expect(d.assetId).to.eql(pm.collectionVariables.get('assetId'));",
              "});"
            ]
          }
        }
      ]
    },
