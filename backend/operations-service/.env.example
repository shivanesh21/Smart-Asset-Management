PORT=3002
NODE_ENV=development
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/operations_db?retryWrites=true&w=majority
ASSET_SERVICE_URL=http://localhost:3001
ASSET_SERVICE_TIMEOUT_MS=5000
JWT_SECRET=<same-value-as-asset-service>
JWT_ISSUER=asset-service
JWT_AUDIENCE=asset-service,operations-service
# Must match asset-service SERVICE_TOKEN so status-sync calls are accepted
SERVICE_TOKEN=<shared-internal-service-token>
CORS_ORIGINS=http://localhost:5173
