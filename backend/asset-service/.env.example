PORT=3001
NODE_ENV=development
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/asset_db?retryWrites=true&w=majority
JWT_SECRET=<generate-with-crypto-random-48-bytes-base64url>
JWT_EXPIRES_IN=1h
JWT_ISSUER=asset-service
JWT_AUDIENCE=asset-service,operations-service
# Shared secret for service-to-service calls (e.g. operations-service -> asset-service status sync)
SERVICE_TOKEN=<shared-internal-service-token>
CORS_ORIGINS=http://localhost:5173
